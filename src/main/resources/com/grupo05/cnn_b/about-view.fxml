<?import javafx.scene.control.*?><?import javafx.scene.layout.*?><?import javafx.scene.shape.Circle?>
<ScrollPane xmlns:fx="http://javafx.com/fxml" fitToWidth="true" hbarPolicy="NEVER" styleClass="screen-scroll"><content><VBox spacing="18" styleClass="page-content">
<VBox spacing="6"><Label text="04 · PROYECTO" styleClass="eyebrow cyan"/><Label text="Acerca del proyecto" styleClass="page-title"/><Label text="Aplicación de escritorio desarrollada por el Grupo 05 para analizar ecografías mamarias con el Modelo B. Presenta una estimación entre las clases benigna, maligna y normal como apoyo informativo; no reemplaza la evaluación de un especialista." styleClass="body" wrapText="true"/></VBox>
<GridPane hgap="14" vgap="14"><columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
<VBox styleClass="card" spacing="8"><Label text="OBJETIVO" styleClass="eyebrow cyan"/><Label text="Clasificar ecografías mamarias en tres clases (benigna, maligna y normal) mediante una red neuronal convolucional, como herramienta de apoyo para la revisión del médico especialista." styleClass="body" wrapText="true"/></VBox>
<VBox styleClass="card" spacing="8" GridPane.columnIndex="1"><Label text="DATASET BUSI" styleClass="eyebrow cyan"/><Label text="Breast Ultrasound Images Dataset (Al-Dhabyani et al., 2020): 780 ecografías de 600 pacientes de entre 25 y 75 años, adquiridas en 2018 en el Hospital Baheya (El Cairo). 437 benignas, 210 malignas y 133 normales." styleClass="body" wrapText="true"/></VBox>
<VBox styleClass="card" spacing="8" GridPane.rowIndex="1"><Label text="MÉTODO" styleClass="eyebrow cyan"/><Label text="Modelo B: EfficientNetB0 preentrenada con ImageNet como extractor de características (transferencia de aprendizaje), seguida de Global Average Pooling, una capa densa de 256 neuronas y una salida softmax de 3 clases. Entrada de 224 × 224 × 3." styleClass="body" wrapText="true"/></VBox>
<VBox styleClass="card" spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="1"><Label text="LIMITACIONES" styleClass="eyebrow warning"/><Label text="Conjunto de datos reducido y de una sola institución." styleClass="body" wrapText="true"/><Label text="Resultados menos fiables con imágenes de otras fuentes." styleClass="body" wrapText="true"/><Label text="No sustituye el criterio clínico." styleClass="body" wrapText="true"/></VBox></GridPane>
<VBox spacing="12" styleClass="card"><Label text="CRÉDITOS · GRUPO 05" styleClass="eyebrow cyan"/>
