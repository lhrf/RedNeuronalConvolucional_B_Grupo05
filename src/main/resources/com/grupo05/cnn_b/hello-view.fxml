<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.shape.Circle?>
<StackPane fx:id="rootStack" xmlns:fx="http://javafx.com/fxml" fx:controller="com.grupo05.cnn_b.HelloController" styleClass="root">
  <children>
  <BorderPane fx:id="appRoot">
    <left>
        <VBox fx:id="sidebar" spacing="12" styleClass="sidebar">
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="brand-block"><StackPane styleClass="ribbon-logo"><SVGPath fx:id="ribbonPath" content="M 21 55 L 36.5 31 C 42 22 40.5 9 32 9 C 23.5 9 22 22 27.5 31 L 43 55" styleClass="ribbon-path"/><SVGPath content="M 12 22 L 27 27 M 52 22 L 37 27 M 12 22 L 19 42 M 52 22 L 45 42" styleClass="ribbon-links"/><Circle radius="3" centerX="12" centerY="22" styleClass="network-node"/><Circle radius="3" centerX="52" centerY="22" styleClass="network-node"/><Circle radius="3" centerX="19" centerY="42" styleClass="network-node"/><Circle radius="3" centerX="45" centerY="42" styleClass="network-node"/></StackPane><VBox spacing="2"><Label text="CNN_B" styleClass="brand"/><Label text="APOYO CLÍNICO" styleClass="eyebrow"/></VBox></HBox>
            <Label text="MÓDULOS" styleClass="eyebrow modules-label"/>
            <Separator/>
            <Button fx:id="navDiagnosis" text="Diagnóstico" onAction="#irDiagnostico" maxWidth="Infinity" styleClass="nav-active"><graphic><SVGPath content="M 12 5 A 7 7 0 1 0 12 19 A 7 7 0 1 0 12 5 M 12 9.8 A 2.2 2.2 0 1 0 12 14.2 A 2.2 2.2 0 1 0 12 9.8 M 12 2 L 12 5 M 12 19 L 12 22 M 2 12 L 5 12 M 19 12 L 22 12" styleClass="nav-icon"/></graphic></Button>
            <Button fx:id="navArchitecture" text="Cómo analiza la red" onAction="#irArquitectura" maxWidth="Infinity" styleClass="nav-button"><graphic><SVGPath content="M 5 4 A 2 2 0 1 0 5 8 A 2 2 0 1 0 5 4 M 5 16 A 2 2 0 1 0 5 20 A 2 2 0 1 0 5 16 M 12 10 A 2 2 0 1 0 12 14 A 2 2 0 1 0 12 10 M 19 10 A 2 2 0 1 0 19 14 A 2 2 0 1 0 19 10 M 6.6 7.2 L 10.4 10.8 M 6.6 16.8 L 10.4 13.2 M 14 12 L 17 12" styleClass="nav-icon"/></graphic></Button>
            <Button fx:id="navMetrics" text="Métricas del modelo" onAction="#irMetricas" maxWidth="Infinity" styleClass="nav-button"><graphic><SVGPath content="M 4 12 H 8 V 20 H 4 Z M 10 7 H 14 V 20 H 10 Z M 16 4 H 20 V 20 H 16 Z" styleClass="nav-icon"/></graphic></Button>
            <Button fx:id="navAbout" text="Acerca del proyecto" onAction="#irAcerca" maxWidth="Infinity" styleClass="nav-button"><graphic><SVGPath content="M 4 3 H 20 V 21 H 4 Z M 8 8 H 16 M 8 12 H 16 M 8 16 H 12" styleClass="nav-icon"/></graphic></Button>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox styleClass="model-status" spacing="6"><Label text="MODELO B" styleClass="eyebrow"/><Label fx:id="backendStatus" text="Cargando" styleClass="status-loading"/><Label text="EfficientNetB0" styleClass="technical"/></VBox>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="mainStack" styleClass="main-stack" minWidth="0" minHeight="0">
            <Canvas fx:id="networkCanvas" mouseTransparent="true" managed="false"/>
            <StackPane fx:id="pageHost" minWidth="0" minHeight="0">
            <fx:include fx:id="diagnostic" source="diagnostic-view.fxml"/>
            </StackPane>
            <Label fx:id="statusLabel" visible="false" managed="false"/>
            <Label fx:id="toastLabel" visible="false" managed="false" styleClass="toast" StackPane.alignment="BOTTOM_RIGHT"/>
        </StackPane>
    </center>
    <bottom><VBox spacing="0"><HBox styleClass="warning-strip" alignment="CENTER_LEFT" spacing="10"><SVGPath content="M 12 3 L 19 6 L 19 11 C 19 15.5 16 19 12 21 C 8 19 5 15.5 5 11 L 5 6 Z" styleClass="notice-icon"/><Label text="Herramienta de apoyo: la decisión diagnóstica final corresponde al médico especialista. Entrenada con BUSI; con imágenes de otras fuentes los resultados pueden ser menos fiables. No verifica que la imagen sea una ecografía mamaria." wrapText="true" styleClass="warning-text"/></HBox><HBox styleClass="status-bar" alignment="CENTER_LEFT"><Label text="Inferencia local · sin conexión" styleClass="status-text"/><Region HBox.hgrow="ALWAYS"/><Label text="CNN_B · Grupo 05 · UPN · 2026" styleClass="status-text"/></HBox></VBox></bottom>
  </BorderPane>
  <VBox fx:id="splash" alignment="CENTER" spacing="20" styleClass="splash"><StackPane styleClass="splash-mark"><SVGPath content="M 21 55 L 36.5 31 C 42 22 40.5 9 32 9 C 23.5 9 22 22 27.5 31 L 43 55" styleClass="splash-ribbon"/><SVGPath content="M 12 22 L 32 9 M 52 22 L 32 9 M 12 22 L 27 30 M 52 22 L 37 30 M 12 22 L 21 55 M 52 22 L 43 55" styleClass="splash-links"/><Circle radius="3.2" centerX="12" centerY="22" styleClass="splash-node"/><Circle radius="3.2" centerX="52" centerY="22" styleClass="splash-node"/><Circle radius="3" centerX="32" centerY="9" styleClass="splash-node hollow"/><Circle radius="3.2" centerX="21" centerY="55" styleClass="splash-node"/><Circle radius="3.2" centerX="43" centerY="55" styleClass="splash-node"/></StackPane><HBox alignment="CENTER" spacing="8"><Label text="CNN_B" styleClass="splash-wordmark"/><Label text="·" styleClass="splash-separator"/><Label text="Análisis de ecografías mamarias" styleClass="splash-title"/></HBox><VBox spacing="10" styleClass="splash-progress"><ProgressBar fx:id="loadingProgress" progress="0" maxWidth="Infinity"/><HBox spacing="10"><Label text="Cargando modelo…" styleClass="muted"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="loadingPercent" text="0 %" styleClass="splash-percent"/></HBox><Label fx:id="loadingMessage" text="Preparación del modelo local" styleClass="technical"/></VBox><VBox fx:id="backendErrorBox" visible="false" managed="false" spacing="10" alignment="CENTER"><Label fx:id="backendError" wrapText="true" styleClass="warning"/><Button text="Reintentar" onAction="#reintentar" styleClass="primary"/></VBox><Label text="Desarrollado por el Grupo 05 · UPN" styleClass="splash-credit"/></VBox>
  </children>
</StackPane>
